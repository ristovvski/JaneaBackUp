{
  "name": "icp-scoring",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Janea ICP v5 auto-scoring: deterministic engine, classifier prompts, Pipedrive/Clay/n8n wiring (Phase 1)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/contract/*.test.mjs\" \"tests/static/*.test.mjs\" \"tests/golden/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:contract": "node --test \"tests/contract/*.test.mjs\"",
    "test:static": "node --test \"tests/static/*.test.mjs\"",
    "test:golden": "node --test \"tests/golden/*.test.mjs\"",
    "live": "node tests/live/dev_e2e.mjs",
    "gen:formula": "node scripts/gen_clay_formula.mjs",
    "gen:config": "node scripts/gen_config_node.mjs",
    "audit:coverage": "node scripts/pipedrive_audit_coverage.mjs",
    "pipedrive:fields": "node scripts/pipedrive_create_fields.mjs",
    "pipedrive:webhook": "node scripts/pipedrive_register_webhook.mjs",
    "golden:export": "node scripts/export_golden_set.mjs",
    "patch": "node n8n/patch/patch.mjs",
    "gen:prompts": "node scripts/gen_prompts.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
